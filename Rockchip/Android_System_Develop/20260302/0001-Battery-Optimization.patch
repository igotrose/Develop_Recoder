+    private void scheduleInactivityShutdown() {
+        cancelInactivityShutdownAlarmOnly();
+        final long triggerAt = SystemClock.elapsedRealtime() + INACTIVITY_SHUTDOWN_DELAY_MS;
+        if (mAlarmManager != null) {
+            mAlarmManager.setExactAndAllowWhileIdle(
+                    AlarmManager.ELAPSED_REALTIME_WAKEUP,
+                    triggerAt,
+                    getInactivityShutdownPendingIntent());
+        }
+    }
+
+    private void cancelInactivityShutdownAlarmOnly() {
+        if (mAlarmManager != null) {
+            mAlarmManager.cancel(getInactivityShutdownPendingIntent());
+        }
+    }
 
+    private void cancelInactivityShutdown() {
+        cancelInactivityShutdownAlarmOnly();
+        mWarnings.dismissInactivityShutdownWarning();
+    }
+
+    private PendingIntent getInactivityShutdownPendingIntent() {
+        if (mInactivityShutdownPendingIntent == null) {
+            Intent intent = new Intent(ACTION_INACTIVITY_SHUTDOWN_TRIGGER)
+                    .setPackage(mContext.getPackageName())
+                    .setFlags(Intent.FLAG_RECEIVER_FOREGROUND);
+            mInactivityShutdownPendingIntent = PendingIntent.getBroadcast(
+                    mContext, 0, intent,
+                    PendingIntent.FLAG_UPDATE_CURRENT | PendingIntent.FLAG_IMMUTABLE);
+        }
+        return mInactivityShutdownPendingIntent;
+    }
 
