+    @Override
+    public void showInactivityShutdownWarning(int countdownSeconds) {
+        mHandler.post(() -> showInactivityShutdownWarningInternal(countdownSeconds));
+    }
+
+    @Override
+    public void dismissInactivityShutdownWarning() {
+        mHandler.post(this::dismissInactivityShutdownWarningInternal);
+    }
+
+    private void showInactivityShutdownWarningInternal(int countdownSeconds) {
+        Slog.i(TAG, "show inactivity shutdown warning, countdownSeconds=" + countdownSeconds);
+        if (countdownSeconds <= 0) {
+            shutdownByInactivity();
+            return;
+        }
+        dismissInactivityShutdownWarningInternal();
+        mInactivityShutdownSecondsLeft = countdownSeconds;
+
+        final SystemUIDialog d = new SystemUIDialog(mContext, R.style.Theme_SystemUI_Dialog_Alert);
+        d.setCancelable(false);
+        d.setShowForAllUsers(true);
+        d.setTitle(R.string.inactivity_shutdown_title);
+        d.setMessage(mContext.getString(R.string.inactivity_shutdown_dialog_message,
+                mInactivityShutdownSecondsLeft));
+        d.setPositiveButton(R.string.inactivity_shutdown_now,
+                (dialog, which) -> shutdownByInactivity());
+        d.setNegativeButton(android.R.string.cancel,
+                (dialog, which) -> dismissInactivityShutdownWarningInternal());
+        d.setOnDismissListener(dialog -> {
+            Slog.i(TAG, "inactivity shutdown dialog dismissed");
+            mInactivityShutdownDialog = null;
+        });
+        d.getWindow().addFlags(WindowManager.LayoutParams.FLAG_TURN_SCREEN_ON
+                | WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON);
+        d.show();
+        mInactivityShutdownDialog = d;
+        mHandler.postDelayed(mInactivityShutdownTick, 1000);
+    }
+
+    private void dismissInactivityShutdownWarningInternal() {
+        mHandler.removeCallbacks(mInactivityShutdownTick);
+        if (mInactivityShutdownDialog != null) {
+            mInactivityShutdownDialog.dismiss();
+            mInactivityShutdownDialog = null;
+        }
+    }
+
+    private void shutdownByInactivity() {
+        Slog.i(TAG, "shutdown by inactivity timeout");
+        dismissInactivityShutdownWarningInternal();
+        try {
+            mPowerMan.shutdown(false, "inactivity_timeout", false);
+        } catch (Exception e) {
+            Slog.e(TAG, "Failed to shutdown by inactivity timeout", e);
+        }
+    }
+
