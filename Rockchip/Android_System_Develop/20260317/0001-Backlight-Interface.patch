diff --git a/base/services/core/java/com/android/server/backlight/RkBacklightService.java b/base/services/core/java/com/android/server/backlight/RkBacklightService.java
new file mode 100644
index 000000000..b4a7a0bac
--- /dev/null
+++ b/base/services/core/java/com/android/server/backlight/RkBacklightService.java
@@ -0,0 +1,104 @@
+package com.android.server.backlight;
+
+import android.content.Context;
+import android.os.IBinder;
+import android.os.RemoteException;
+import android.os.backlight.IRkBacklightService;
+import android.util.Log;    
+
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.FileOutputStream;
+
+public class RkBacklightService extends IRkBacklightService.Stub { 
+    private static final String TAG = "RkBacklightService";
+
+    private static final String BACKLIGHT = "/sys/class/backlight/backlight/brightness";
+    
+    public static final int CODE_SUCCESS = 0;
+    public static final int CODE_FAILED = -1;
+    public static final int CODE_INVALID_PARAM = -2;
+
+    private final Context mContext;
+
+    public RkBacklightService(Context context) throws RemoteException {
+        mContext = context;
+    }
+
+    @Override
+    public int setBacklight(int level) throws RemoteException {
+        if (level < 0 || level > 255) {
+            return CODE_INVALID_PARAM;
+        }
+
+        boolean ok = writeNode(BACKLIGHT, level);
+
+        if (!ok)
+            return CODE_FAILED;
+        return CODE_SUCCESS;
+    }
+
+    @Override 
+    public int getBacklight() throws RemoteException {
+        Integer value = readNode(BACKLIGHT);
+        if (value != null)
+            return value;
+        
+        value = readNode(BACKLIGHT);
+        if (value != null)
+            return value;
+        return CODE_FAILED;
+    }
+
+    private boolean writeNode(String path, int value) {
+        File file = new File(path);
+        if (!file.exists())
+            return false;
+        
+        FileOutputStream fos = null;
+        try {
+            fos = new FileOutputStream(file);
+            fos.write((String.valueOf(value) + "\n").getBytes());
+            fos.flush();
+            return true;    
+        } catch (Exception e) {
+            e.printStackTrace();
+            return false;
+        } finally {
+            try {
+                if (fos != null)
+                    fos.close();
+            } catch (Exception ignored) {
+            }
+        }
+    }
+
+    private Integer readNode(String path) {
+        File file = new File(path);
+        if (!file.exists()) {
+            return null;
+        }
+
+        FileInputStream fis = null;
+        try {
+            byte[] buf = new byte[32];
+            fis = new FileInputStream(file);
+            int len = fis.read(buf);
+            if (len <= 0) {
+                return null;
+            }
+            String value = new String(buf, 0, len).trim();
+            return Integer.parseInt(value);
+        } catch (Exception e) {
+            Log.e(TAG, "readNode failed: " + path, e);
+            return null;
+        } finally {
+            try {
+                if (fis != null) fis.close();
+            } catch (Exception ignored) {
+            }
+        }
+    }
+
+
+}
