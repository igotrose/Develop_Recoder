--- /dev/null
+++ b/base/core/java/android/os/backlight/RkBacklightManager.java
@@ -0,0 +1,46 @@
+package android.os.backlight;
+
+import android.annotation.NonNull;
+import android.annotation.Nullable;
+import android.content.Context;
+import android.os.RemoteException;
+
+public class RkBacklightManager   { 
+
+    public static final int CODE_SUCCESS = 0;  
+    public static final int CODE_FAILED = -1;
+    public static final int CODE_INVALID_PARAM = -2;
+    public static final int CODE_NO_PERMISSION = -3;
+    public static final int CODE_OTHER_ERROR = -4;
+
+    private final Context mContext;
+    private IRkBacklightService mService;
+    
+    /** @hide */
+    public RkBacklightManager (Context context, IRkBacklightService service) {
+        mContext = context;
+        mService = service;
+    }
+
+    public int setBacklight(int level) {
+        try {
+            if (mService != null) {
+                return mService.setBacklight(level);
+            }
+        } catch (RemoteException e) {
+            throw e.rethrowFromSystemServer();
+        }
+        return CODE_FAILED;
+    }
+
+    public int getBacklight() {
+        try {
+            if (mService != null) {
+                return mService.getBacklight();
+            }
+        } catch (RemoteException e) {
+            throw e.rethrowFromSystemServer();
+        }
+        return CODE_FAILED;
+    }
+}
