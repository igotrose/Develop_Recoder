# Set NET_IFACE=auto to select the Quectel USB network interface by USB ID.
# EC20/EC25 usually enumerate as qmi_wwan/wwan0 and use /dev/cdc-wdm0.
# EC200A usually enumerates as cdc_ether/usb0 or rndis_host/usb0.
# Leave AT_DEVICE unset to auto-detect /dev/ttyUSB*.
# QUECTEL_4G_AT_DEVICE=/dev/ttyUSB2
QUECTEL_4G_NET_IFACE=auto
QUECTEL_4G_WDM_DEVICE=/dev/cdc-wdm0

# EC200A in ECM/RNDIS mode needs AT+QNETDEVCTL=1,1,1 before DHCP.
# auto enables it only for cdc_ether/rndis_host interfaces, so EC20/EC25 QMI is
# unaffected.
# QUECTEL_4G_QNETDEVCTL=auto

# Leave APN empty to use the SIM/module default PDP context.
# Set it only for SIM cards that require an explicit APN.
# QUECTEL_4G_APN=internet

# Used when the modem/DHCP path does not populate DNS.
# QUECTEL_4G_FALLBACK_DNS="114.114.114.114 223.5.5.5"

# Timing knobs.
# QUECTEL_4G_DEVICE_TIMEOUT=30
# QUECTEL_4G_MONITOR_INTERVAL=10
# QUECTEL_4G_NET_START_GRACE=5
# QUECTEL_4G_DHCP_TIMEOUT=30
# QUECTEL_4G_MAX_RETRY_INTERVAL=60
