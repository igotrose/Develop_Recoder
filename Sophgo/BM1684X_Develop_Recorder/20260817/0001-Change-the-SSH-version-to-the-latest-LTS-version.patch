+function build_openssh_prebuilt()
+{
+	print_notice "Run ${FUNCNAME[0]}() function"
+	local THIRD_PARTY_DIR="$TOP_DIR/bootloader-arm64/third_party"
+	local PREBUILT_DIR=$TOP_DIR/bootloader-arm64/third_party/prebuilt
+	local PREBUILT_TAR=$PREBUILT_DIR/openssh_openssl_prebuilt.tar.gz
+	local TMP_ROOTFS=$TOP_DIR/install/.tmp_openssh_prebuilt_rootfs
+
+	sudo mkdir -p "$PREBUILT_DIR"
+	sudo rm -f "$PREBUILT_TAR"
+	sudo rm -rf "$TMP_ROOTFS"
+	mkdir -p "$TMP_ROOTFS"
+
+	echo prepare temporary rootfs...
+	zcat $DISTRO_BASE_PKT | sudo tar -C "$TMP_ROOTFS" -x -f -
+
+	if [ -d "$TMP_ROOTFS/distro/focal" ]; then
+		sudo bash -c "mv $TMP_ROOTFS/distro/focal/* $TMP_ROOTFS && rm -rf $TMP_ROOTFS/distro"
+	fi
+	sudo mkdir -p "$TMP_ROOTFS/third_party"
+	sudo cp -a "$THIRD_PARTY_DIR"/. "$TMP_ROOTFS/third_party/"
+	sudo cp /usr/bin/qemu-aarch64-static "$TMP_ROOTFS/usr/bin/"
+	sudo mount --bind /dev "$TMP_ROOTFS/dev"
+	sudo mount --bind /dev/pts "$TMP_ROOTFS/dev/pts"
+	sudo mount --bind /proc "$TMP_ROOTFS/proc"
+	sudo mount --bind /sys "$TMP_ROOTFS/sys"
+
+	echo build openssl/openssh prebuilt in chroot...
+	pushd "$TMP_ROOTFS"
+
+sudo chroot . /usr/bin/qemu-aarch64-static /bin/bash --noprofile --norc << "EOT"
+set -e
+mkdir -p /opt/prebuilt /tmp/build-src /tmp/build-out
+rm -f /opt/prebuilt/openssh_openssl_prebuilt.tar.gz
+
+cd /tmp/build-src
+tar -xf /third_party/openssl-3.5.5.tar.gz
+cd openssl-3.5.5
+./Configure linux-aarch64 --prefix=/usr/local/openssl-3.5.5 --openssldir=/usr/local/openssl-3.5.5/ssl
+
+make -j"$(nproc)"
+make DESTDIR=/tmp/build-out install_sw
+
+cd /tmp/build-src
+tar -xf /third_party/openssh-portable-V_10_2_P1.tar.gz
+cd openssh-portable-*
+
+OPENSSL_STAGE=/tmp/build-out/usr/local/openssl-3.5.5
+[ -d "$OPENSSL_STAGE/lib64" ] && [ ! -e "$OPENSSL_STAGE/lib" ] && ln -s lib64 "$OPENSSL_STAGE/lib"
+
+export CPPFLAGS="-I$OPENSSL_STAGE/include"
+export LDFLAGS="-L$OPENSSL_STAGE/lib64 -L$OPENSSL_STAGE/lib -Wl,-rpath,/usr/local/openssl-3.5.5/lib64 -Wl,-rpath,/usr/local/openssl-3.5.5/lib"
+export PKG_CONFIG_PATH="$OPENSSL_STAGE/lib64/pkgconfig:$OPENSSL_STAGE/lib/pkgconfig"
+export LD_LIBRARY_PATH="$OPENSSL_STAGE/lib64:$OPENSSL_STAGE/lib"
+
+./configure \
+  --prefix=/usr/local/openssh-10.2p1 \
+  --sysconfdir=/usr/local/openssh-10.2p1/etc \
+  --with-ssl-dir="$OPENSSL_STAGE" \
+  --without-pam
+
+make -j"$(nproc)"
+
+mkdir -p /usr/local/openssh-10.2p1/etc
+./ssh-keygen -q -t rsa -f /usr/local/openssh-10.2p1/etc/ssh_host_rsa_key -N ""
+./ssh-keygen -q -t ecdsa -f /usr/local/openssh-10.2p1/etc/ssh_host_ecdsa_key -N ""
+./ssh-keygen -q -t ed25519 -f /usr/local/openssh-10.2p1/etc/ssh_host_ed25519_key -N ""
+
+
+make DESTDIR=/tmp/build-out install
+
+rm -f /usr/local/openssh-10.2p1/etc/ssh_host_*
+rm -f /tmp/build-out/usr/local/openssh-10.2p1/etc/ssh_host_*
+
+
+# change default ssh port from 22 to custom port
+if [ -f /tmp/build-out/usr/local/openssh-10.2p1/etc/sshd_config ]; then
+	sed -i \
+		-e 's/^#Port 22/Port 2222/' \
+		-e 's/^#PermitRootLogin prohibit-password/PermitRootLogin yes/' \
+		-e 's/^#PasswordAuthentication yes/PasswordAuthentication yes/' \
+		/tmp/build-out/usr/local/openssh-10.2p1/etc/sshd_config
+fi
+
+cd /tmp/build-out
+[ -d usr/local/openssh-10.2p1/etc ] && rm -f usr/local/openssh-10.2p1/etc/ssh_host_*
+tar -czf /opt/prebuilt/openssh_openssl_prebuilt.tar.gz .
+EOT
+	popd
+	sudo umount "$TMP_ROOTFS/dev/pts"
+	sudo umount "$TMP_ROOTFS/dev"
+	sudo umount "$TMP_ROOTFS/proc"
+	sudo umount "$TMP_ROOTFS/sys"
+	[ -s "$TMP_ROOTFS/opt/prebuilt/openssh_openssl_prebuilt.tar.gz" ] || { echo "prebuilt tar not generated"; return 1; }
+	sudo cp -f "$TMP_ROOTFS/opt/prebuilt/openssh_openssl_prebuilt.tar.gz" "$PREBUILT_TAR"
+	sudo rm -rf "$TMP_ROOTFS"
+}
