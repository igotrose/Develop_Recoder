--- /dev/null
+++ b/distro/sophgo-fs/usr/sbin/firstboot-install-openssh.sh
@@ -0,0 +1,52 @@
+#!/bin/bash
+set -e
+
+DONE=/var/lib/firstboot-openssh.done
+PKG=/opt/prebuilt/openssh_openssl_prebuilt.tar.gz
+OPENSSH_ROOT=/usr/local/openssh-10.2p1
+SYSTEMD_DIR=/etc/systemd/system
+
+[ -f "$DONE" ] && exit 0
+[ -f "$PKG" ] || exit 1
+
+mkdir -p /var/lib /run/sshd
+chmod 755 /run/sshd
+
+if ! id -u sshd >/dev/null 2>&1; then
+    useradd -r -M -s /usr/sbin/nologin -d /run/sshd sshd
+fi
+
+mkdir -p "$(dirname "$DONE")"
+
+if command -v systemctl >/dev/null 2>&1; then
+    systemctl stop ssh.service ssh.socket sshd.service 2>/dev/null || true
+    systemctl disable ssh.service ssh.socket sshd.service 2>/dev/null || true
+    systemctl mask ssh.service ssh.socket sshd.service 2>/dev/null || true
+fi
+
+rm -f \
+    "$SYSTEMD_DIR"/multi-user.target.wants/ssh.service \
+    "$SYSTEMD_DIR"/sockets.target.wants/ssh.socket \
+    "$SYSTEMD_DIR"/sshd.service
+
+tar -xzf "$PKG" -C /
+rm -f "$OPENSSH_ROOT"/etc/ssh_host_*
+
+"$OPENSSH_ROOT"/bin/ssh-keygen -t rsa -f "$OPENSSH_ROOT"/etc/ssh_host_rsa_key -N ""
+"$OPENSSH_ROOT"/bin/ssh-keygen -t ecdsa -f "$OPENSSH_ROOT"/etc/ssh_host_ecdsa_key -N ""
+"$OPENSSH_ROOT"/bin/ssh-keygen -t ed25519 -f "$OPENSSH_ROOT"/etc/ssh_host_ed25519_key -N ""
+
+ln -sf "$OPENSSH_ROOT"/bin/ssh /usr/local/bin/ssh
+ln -sf "$OPENSSH_ROOT"/bin/scp /usr/local/bin/scp
+ln -sf "$OPENSSH_ROOT"/bin/sftp /usr/local/bin/sftp
+ln -sf "$OPENSSH_ROOT"/bin/ssh-add /usr/local/bin/ssh-add
+ln -sf "$OPENSSH_ROOT"/bin/ssh-agent /usr/local/bin/ssh-agent
+ln -sf "$OPENSSH_ROOT"/bin/ssh-keygen /usr/local/bin/ssh-keygen
+ln -sf "$OPENSSH_ROOT"/bin/ssh-keyscan /usr/local/bin/ssh-keyscan
+
+if command -v systemctl >/dev/null 2>&1; then
+    systemctl daemon-reload
+    systemctl enable openssh-prebuilt.service 2>/dev/null || true
+fi
+
+touch "$DONE"
