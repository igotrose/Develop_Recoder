		reg = <0x00 0x5001e000 0x00 0x1000>;
		reset-names = "i2c2";

		rtc@68 {
			compatible = "dallas,ds1307";
			reg = <0x68>;
		};
	};

	pmu_a53 {
		interrupts = <0x00 0xc4 0x04 0x00 0xc5 0x04 0x00 0xc6 0x04 0x00 0xc7 0x04 0x00 0xd0 0x04 0x00 0xd1 0x04 0x00 0xd2 0x04 0x00 0xd3 0x04>;
		compatible = "arm,cortex-a53-pmu";
	};

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			next-level-cache = <0x10>;
			reg = <0x01>;
			enable-method = "psci";
			phandle = <0x09>;
		};

		l2-cache0 {
			cache-level = <0x02>;
			cache-unified;
			compatible = "cache";
			phandle = <0x10>;
		};

		cpu@103 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			next-level-cache = <0x11>;
			reg = <0x103>;
			enable-method = "psci";
			phandle = <0x0f>;
		};

		cpu@101 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			next-level-cache = <0x11>;
			reg = <0x101>;
			enable-method = "psci";
			phandle = <0x0d>;
		};

		cpu-map {

			cluster0 {

				core3 {
					cpu = <0x0b>;
				};

				core1 {
					cpu = <0x09>;
				};

				core2 {
					cpu = <0x0a>;
				};

				core0 {
					cpu = <0x08>;
				};
			};

			cluster1 {

				core3 {
					cpu = <0x0f>;
				};

				core1 {
					cpu = <0x0d>;
				};

				core2 {
					cpu = <0x0e>;
				};

				core0 {
					cpu = <0x0c>;
				};
			};
		};

		cpu@2 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			next-level-cache = <0x10>;
			reg = <0x02>;
			enable-method = "psci";
			phandle = <0x0a>;
		};

		l2-cache1 {
			cache-level = <0x02>;
			cache-unified;
			compatible = "cache";
			phandle = <0x11>;
		};

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			next-level-cache = <0x10>;
			reg = <0x00>;
			enable-method = "psci";
			phandle = <0x08>;
		};

		cpu@102 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			next-level-cache = <0x11>;
			reg = <0x102>;
			enable-method = "psci";
			phandle = <0x0e>;
		};

		cpu@100 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			next-level-cache = <0x11>;
			reg = <0x100>;
			enable-method = "psci";
			phandle = <0x0c>;
		};

		cpu@3 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			next-level-cache = <0x10>;
			reg = <0x03>;
			enable-method = "psci";
			phandle = <0x0b>;
		};
	};

	vpu@50050000 {
		clock-names = "apb_vd0_wave0\0axi_vd0_wave0\0apb_vd0_wave1\0axi_vd0_wave1\0apb_vd1_wave0\0axi_vd1_wave0\0apb_vd1_wave1\0axi_vd1_wave1\0apb_vde_wave\0axi_vde_wave\0axi_vde_axi_bridge";
		resets = <0x14 0x32 0x14 0x33 0x14 0x3c 0x14 0x3d 0x14 0x4a>;
		memory-region = <0x23>;
		interrupts = <0x00 0x1f 0x04 0x00 0x20 0x04 0x00 0x7f 0x04 0x00 0x80 0x04 0x00 0x40 0x04>;
		clocks = <0x07 0x4a 0x07 0x7d 0x07 0x4b 0x07 0x7c 0x07 0x43 0x07 0x78 0x07 0x44 0x07 0x77 0x07 0x49 0x07 0x72 0x07 0x7e>;
		compatible = "bitmain,bitmain-vdec";
		reg = <0x00 0x50050000 0x00 0x10000 0x00 0x50060000 0x00 0x10000 0x00 0x500d0000 0x00 0x10000 0x00 0x500e0000 0x00 0x10000 0x00 0x50126000 0x00 0x10000>;
		reset-names = "sys0_wave0\0sys0_wave1\0sys1_wave0\0sys1_wave1\0wave521";
