		local-mac-address = [ee f3 27 ad df 41];
		interrupts = <0x00 0x0c 0x04>;
		clocks = <0x07 0x0b 0x07 0x30 0x07 0x52 0x07 0x31 0x07 0x32>;
		snps,rxpbl = <0x20>;
		compatible = "bitmain,ethernet";
		interrupt-names = "macirq";
		reg = <0x00 0x5010c000 0x00 0x4000>;
		snps,axi-config = <0x20>;
		snps,perfect-filter-entries = <0x01>;
