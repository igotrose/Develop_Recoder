	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		linux,cma {
			linux,cma-default;
			alignment = <0x00 0x2000>;
			compatible = "shared-dma-pool";
			size = <0x00 0x8000000>;
			reusable;
		};

		ion_vpu_mem {
			compatible = "vpu-region";
			reg = <0x03 0x80000000 0x00 0x7ff00000>;
			phandle = <0x35>;
		};

		smmu_mem {
			reg = <0x01 0x24000000 0x00 0x100000>;
			phandle = <0x27>;
			no-map;
		};

		bl31_mem {
			reg = <0x03 0x00 0x00 0x40000>;
			no-map;
		};

		ramoops_mem {
			record-size = <0x20000>;
			compatible = "ramoops";
			console-size = <0x20000>;
			reg = <0x03 0x14000000 0x00 0x100000>;
		};

		ion_vpp_mem {
			compatible = "vpp-region";
			reg = <0x04 0x40000000 0x00 0xc0000000>;
			phandle = <0x29>;
		};

		arm_mem {
			reg = <0x01 0x20000000 0x00 0x4000000>;
			phandle = <0x26>;
			no-map;
		};

		armfw_mem {
			reg = <0x01 0x00 0x00 0x20000000>;
			phandle = <0x25>;
			no-map;
		};

		ion_npu_mem {
			compatible = "npu-region";
			reg = <0x01 0x24100000 0x00 0xf6e00000>;
			phandle = <0x28>;
		};

		vpu_mem {
			reg = <0x03 0x78000000 0x00 0x8000000>;
			phandle = <0x23>;
			no-map;
		};
	};

	top_misc_ctrl@0x50010000 {
		clock-names = "dbg_i2c_clk\0axi_sram_clk\0apb_rom_clk";
		clocks = <0x07 0x83 0x07 0x85 0x07 0x3c>;
		compatible = "bitmain,top-misc\0syscon";
		reg = <0x00 0x50010000 0x00 0x8000>;
		phandle = <0x02>;
	};

	gpio@50027000 {
		#address-cells = <0x01>;
		clock-names = "base_clk\0intr_clk\0db_clk";
		clocks = <0x07 0x3d 0x07 0x48 0x07 0x61>;
		#size-cells = <0x00>;
		compatible = "snps,dw-apb-gpio";
		reg = <0x00 0x50027000 0x00 0x400>;

		gpio-controller@0 {
			gpio-controller;
			interrupts = <0x00 0x14 0x04>;
			interrupt-parent = <0x01>;
			compatible = "snps,dw-apb-gpio-port";
			#interrupt-cells = <0x02>;
			reg = <0x00>;
			phandle = <0x12>;
			bank-name = "port0a";
			snps,nr-gpios = <0x20>;
			#gpio-cells = <0x02>;
			interrupt-controller;

			gpio5 {
				gpio-hog;
				output-high;
				status = "okay";
				gpios = <0x05 0x00>;
			};

			gpio30 {
				gpio-hog;
				output-high;
				status = "okay";
				gpios = <0x1e 0x00>;
			};

			gpio6 {
				gpio-hog;
				output-high;
				status = "okay";
				gpios = <0x06 0x00>;
			};
		};
	};

	jpu@50030000 {
		clock-names = "apb_vd0_jpeg0\0axi_vd0_jpeg0\0apb_vd0_jpeg1\0axi_vd0_jpeg1\0apb_vd1_jpeg0\0axi_vd1_jpeg0\0apb_vd1_jpeg1\0axi_vd1_jpeg1";
		resets = <0x14 0x34 0x14 0x35 0x14 0x3e 0x14 0x3f>;
		interrupts = <0x00 0x1c 0x04 0x00 0x1d 0x04 0x00 0x7c 0x04 0x00 0x7d 0x04>;
		clocks = <0x07 0x4c 0x07 0x7b 0x07 0x4d 0x07 0x7a 0x07 0x45 0x07 0x76 0x07 0x46 0x07 0x75>;
		compatible = "bitmain,jpeg";
		reg = <0x00 0x50030000 0x00 0x300 0x00 0x50040000 0x00 0x300 0x00 0x500b0000 0x00 0x300 0x00 0x500c0000 0x00 0x300 0x00 0x50010060 0x00 0x04>;
		reset-names = "sys0_jpeg0\0sys0_jpeg1\0sys1_jpeg0\0sys1_jpeg1";
	};

	dw-apb-timer0@50022000 {
		clock-names = "timer";
		interrupts = <0x00 0x18 0x04>;
		clocks = <0x07 0x3a>;
		clk-drv-rating = <0x12c>;
		compatible = "snps,dw-apb-timer";
		reg = <0x00 0x50022000 0x00 0x14>;
	};

	interrupt-controller {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		compatible = "arm,cortex-a15-gic";
		ranges;
		#interrupt-cells = <0x03>;
		reg = <0x00 0x50001000 0x00 0x1000 0x00 0x50002000 0x00 0x2000>;
		phandle = <0x01>;
		interrupt-controller;
	};

	bm1684_cooling {
		compatible = "bitmain,bm1684-cooling";
		phandle = <0x2d>;
		#cooling-cells = <0x02>;
		hwlocks = <0x34 0x01>;
	};

	memory {
		device_type = "memory";
		reg = <0x01 0x00 0x01 0x00 0x02 0x00 0x01 0x00 0x03 0x00 0x01 0x00 0x04 0x00 0x01 0x00>;
	};

	m2m@0 {
		compatible = "sophgo,m2m-dma";
	};
};
