/dts-v1/;

/ {
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	interrupt-parent = <0x01>;
	compatible = "linux,dummy-virt";

	tsdma@0x0200B000 {
		clock-names = "tsdmaclk";
		dma-masters = [02];
		interrupts = <0x00 0x22 0x04>;
		clocks = <0x07 0x88>;
		block_size = <0x20>;
		dma-requests = [10];
		compatible = "snps,dmac-bm";
		block-ts = <0x1f>;
		chan_allocation_order = [00];
		reg = <0x00 0x200b000 0x00 0x1000>;
		dma-channels = [08];
		axi_tr_width = <0x04>;
		chan_priority = [00];
		#dma-cells = <0x03>;
		data-width = <0x01 0x01>;
	};

	tx-queues-config {
		phandle = <0x22>;
		snps,tx-queues-to-use = <0x04>;

		queue3 {
		};

		queue1 {
		};

		queue2 {
		};

		queue0 {
		};
	};

	bmcpu {
		status = "disable";
	};

	serial@5011C000 {
		reg-io-width = <0x04>;
		pinctrl-names = "default";
		pinctrl-0 = <0x13>;
		clock-names = "baudclk\0apb_pclk";
		interrupts = <0x00 0x07 0x04>;
		clocks = <0x07 0x33 0x07 0x53>;
		clock-frequency = <0x1dcd6500>;
		compatible = "snps,dw-apb-uart";
		reg = <0x00 0x5011c000 0x00 0x2000>;
		reg-shift = <0x02>;
	};

	serial@50118000 {
		reg-io-width = <0x04>;
		clock-names = "baudclk\0apb_pclk";
		interrupts = <0x00 0x01 0x04>;
		clocks = <0x07 0x33 0x07 0x53>;
		clock-frequency = <0x1dcd6500>;
		compatible = "snps,dw-apb-uart";
		reg = <0x00 0x50118000 0x00 0x2000>;
		reg-shift = <0x02>;
	};

	subsys_inten {
		uart-int-mask = <0x07>;
		regbase = <0x5011900c>;
		compatible = "bitmain,subsys-int-en";
		uart-int-offset = <0x01>;
	};

	sysdma@0x50110000 {
		clock-names = "sysdmaclk";
		dma-masters = [02];
		interrupts = <0x00 0x00 0x04>;
		clocks = <0x07 0x53>;
		block_size = <0x20>;
		dma-requests = [10];
		compatible = "snps,dmac-bm";
		block-ts = <0x1f>;
		chan_allocation_order = [00];
		reg = <0x00 0x50110000 0x00 0x1000>;
		dma-channels = [08];
		axi_tr_width = <0x04>;
		chan_priority = [00];
		#dma-cells = <0x03>;
		data-width = <0x01 0x01>;
	};

	i2c@5001A000 {
		#address-cells = <0x01>;
		clock-names = "pclk";
		resets = <0x14 0x1a>;
		interrupts = <0x00 0x19 0x04>;
		clocks = <0x07 0x3f>;
		#size-cells = <0x00>;
		clock-frequency = <0x186a0>;
		compatible = "snps,designware-i2c";
		reg = <0x00 0x5001a000 0x00 0x1000>;
		reset-names = "i2c0";
	};

	vnic {
		clock-names = "pcie\0cdma\0smmu";
		reg-names = "top_misc\0pcie_cfg\0cdma_cfg";
		resets = <0x14 0x2b 0x14 0x2c>;
		interrupts = <0x00 0x7b 0x04 0x00 0x2e 0x04>;
		clocks = <0x07 0x55 0x07 0x56 0x07 0x54>;
		compatible = "bitmain,vnic";
		handshake-reg = <0x00 0x5fb801e8>;
		interrupt-names = "rx\0cdma";
		reg = <0x00 0x50010000 0x00 0x8000 0x00 0x5f800000 0x00 0x400000 0x00 0x58003000 0x00 0x1000>;
		reset-names = "cdma\0smmu";
	};

	stmmac-axi-config {
		snps,wr_osr_lmt = <0x01>;
		phandle = <0x20>;
		snps,blen = <0x04 0x08 0x10 0x00 0x00 0x00 0x00>;
		snps,rd_osr_lmt = <0x02>;
	};

	tach@50029028 {
		pinctrl-names = "default";
		pinctrl-0 = <0x1f>;
		compatible = "bitmain,bm-tach";
		reg = <0x00 0x50029028 0x00 0x08>;
	};

	vpp@50070000 {
		clock-names = "apb_vpp0\0axi_vpp0\0apb_vpp1\0axi_vpp1";
		resets = <0x14 0x36 0x14 0x40>;
		interrupts = <0x00 0x1e 0x04 0x00 0x7e 0x04>;
		clocks = <0x07 0x4e 0x07 0x79 0x07 0x47 0x07 0x74>;
		compatible = "bitmain, bitmain-vpp";
		reg = <0x00 0x50070000 0x00 0x1000 0x00 0x500f0000 0x00 0x1000>;
		reset-names = "vpp0\0vpp1";
	};

	gpio-leds {
		compatible = "gpio-leds";

		gpio7 {
			label = "RUN-gpio7";
			default-state = "on";
			gpios = <0x12 0x07 0x00>;
		};

		status {
			label = "status";
			default-state = "on";
			gpios = <0x12 0x07 0x00>;
		};
	};

	bm-wd@50026000 {
		subctrl-syscon = <0x02>;
		resets = <0x14 0x23>;
		interrupts = <0x00 0x17 0x04>;
		clocks = <0x07 0x40>;
		compatible = "snps,dw-wdt";
		reg = <0x00 0x50026000 0x00 0x1000>;
	};

	bitmain,bm-cpufreq {
		bitmain,cpufreq-table = <0x231860 0x118c30>;
		compatible = "bitmain,bm-cpufreq";
	};

	thermal-zones {

		soc {
			polling-delay = <0x3e8>;
			polling-delay-passive = <0x3e8>;
			thermal-sensors = <0x2b 0x01>;

			trips {

				soc_tpuclk75m_trip {
					temperature = <0x15f90>;
					hysteresis = <0x1388>;
					type = "active";
					phandle = <0x2e>;
				};

				soc_pwmfan_trip@4 {
					temperature = <0x13880>;
					hysteresis = <0x1388>;
					type = "active";
					phandle = <0x33>;
				};

				soc_pwmfan_trip@2 {
					temperature = <0xfde8>;
					hysteresis = <0x2ee0>;
					type = "active";
					phandle = <0x31>;
				};

				soc_pwmfan_trip@3 {
					temperature = <0x124f8>;
					hysteresis = <0x2710>;
					type = "active";
					phandle = <0x32>;
				};

				soc_crit_trip {
					temperature = <0x17318>;
					hysteresis = <0x00>;
					type = "critical";
				};

				soc_tpuclk440m_trip {
					temperature = <0x14c08>;
					hysteresis = <0x1388>;
					type = "active";
					phandle = <0x2c>;
				};

				soc_pwmfan_trip@1 {
					temperature = <0xcf08>;
					hysteresis = <0x1f40>;
					type = "active";
					phandle = <0x2f>;
				};
			};

			cooling-maps {

				map6 {
					trip = <0x33>;
					cooling-device = <0x30 0x03 0x04>;
				};

				map4 {
					trip = <0x31>;
					cooling-device = <0x30 0x01 0x02>;
				};

				map0 {
					trip = <0x2c>;
					cooling-device = <0x2d 0xffffffff 0x01>;
				};

				map5 {
					trip = <0x32>;
					cooling-device = <0x30 0x02 0x03>;
				};

				map3 {
					trip = <0x2f>;
					cooling-device = <0x30 0x00 0x01>;
				};

				map1 {
					trip = <0x2e>;
					cooling-device = <0x2d 0x02 0xffffffff>;
				};
			};
		};

		board {
			polling-delay = <0x1388>;
			polling-delay-passive = <0x1388>;
			thermal-sensors = <0x2b 0x00>;
		};
	};

	veth {
		reg-names = "shm_reg\0top_misc\0intc_cfg\0cdma_cfg";
		interrupts = <0x00 0x7b 0x04>;
		compatible = "sophgon, veth";
		status = "disabled";
		interrupt-names = "rx";
		reg = <0x00 0x101fb400 0x00 0x100 0x00 0x50010000 0x00 0x8000 0x00 0x50023000 0x00 0x1000 0x00 0x58003000 0x00 0x1000>;
	};

	clocks {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		oscillator {
			clock-output-names = "osc";
			#clock-cells = <0x00>;
			clock-frequency = <0x17d7840>;
			compatible = "fixed-clock";
			phandle = <0x03>;
		};

		tpll {
			subctrl-syscon = <0x02>;
			clock-output-names = "tpll_clk";
			mode = <0x00>;
			id = <0x01>;
			clocks = <0x03>;
			#clock-cells = <0x00>;
			compatible = "bitmain, pll-clock";
			phandle = <0x05>;
		};

		fpll {
			subctrl-syscon = <0x02>;
			clock-output-names = "fpll_clk";
			mode = <0x00>;
			id = <0x02>;
			clocks = <0x03>;
			#clock-cells = <0x00>;
			compatible = "bitmain, pll-clock";
		};

		div_clk {
			id = <0x00>;
			#clock-cells = <0x01>;
			compatible = "bitmain, pll-child-clock";
			phandle = <0x07>;
		};

		ctrystal {
			clock-output-names = "cgi";
			#clock-cells = <0x00>;
			clock-frequency = <0x17d7840>;
			compatible = "fixed-clock";
		};

		vpll {
			subctrl-syscon = <0x02>;
			clock-output-names = "vpll_clk";
			mode = <0x00>;
			id = <0x03>;
			clocks = <0x03>;
			#clock-cells = <0x00>;
			compatible = "bitmain, pll-clock";
			phandle = <0x06>;
		};

		dpll0 {
			subctrl-syscon = <0x02>;
			clock-output-names = "dpll0_clk";
			mode = <0x00>;
			id = <0x04>;
			clocks = <0x03>;
			#clock-cells = <0x00>;
			compatible = "bitmain, pll-clock";
		};

		mux_clk {
			id = <0x01>;
			#clock-cells = <0x01>;
			compatible = "bitmain, pll-mux-clock";
		};

		default_rates {
			clocks = <0x04 0x05 0x06 0x07 0x02 0x07 0x03 0x07 0x04 0x07 0x05 0x07 0x06 0x07 0x07 0x07 0x08 0x07 0x09 0x07 0x0a 0x07 0x0b 0x07 0x0c 0x07 0x0d 0x07 0x0e 0x07 0x0f 0x07 0x10 0x07 0x11 0x07 0x12 0x07 0x13 0x07 0x14 0x07 0x15 0x07 0x16 0x07 0x17 0x07 0x18 0x07 0x19 0x07 0x1a 0x07 0x1b 0x07 0x1c 0x07 0x1d 0x07 0x1e 0x07 0x1f 0x07 0x20 0x07 0x21 0x07 0x22 0x07 0x25 0x07 0x23 0x07 0x24 0x07 0x00 0x07 0x01>;
			#clock-cells = <0x01>;
			compatible = "bitmain, clk-default-rates";
			clock-rates = <0x89173700 0x389fd980 0x2faf0800 0x3b9aca00 0x3b9aca00 0x77359400 0x2faf080 0x5f5e100 0x5f5e100 0x7735940 0x2faf080 0x17d7840 0x7735940 0x2faf080 0x17d7840 0x1dcd6500 0x17d7840 0x3b9aca00 0x1dcd6500 0x2faf0800 0x5f5e100 0xee6b280 0xee6b280 0x1dcd6500 0x1dcd6500 0x2faf080 0x2faf080 0x2faf080 0x2faf080 0x2faf080 0x2faf080 0x2faf080 0x2faf080 0x186a0 0x186a0 0x186a0 0x3b9aca01 0x2faf0800 0x2faf0801 0x89173701 0x2245cdc0>;
		};

		mpll {
			subctrl-syscon = <0x02>;
			clock-output-names = "mpll_clk";
			mode = <0x00>;
			id = <0x00>;
			clocks = <0x03>;
			#clock-cells = <0x00>;
			compatible = "bitmain, pll-clock";
			phandle = <0x04>;
		};

		dpll1 {
			subctrl-syscon = <0x02>;
			clock-output-names = "dpll1_clk";
			mode = <0x00>;
			id = <0x05>;
			clocks = <0x03>;
			#clock-cells = <0x00>;
			compatible = "bitmain, pll-clock";
		};
	};

	top_intc {
		reg-names = "sta\0set\0clr";
		interrupts = <0x00 0x30 0x04 0x00 0x31 0x04 0x00 0x32 0x04 0x00 0x33 0x04 0x00 0x34 0x04 0x00 0x35 0x04 0x00 0x36 0x04 0x00 0x37 0x04 0x00 0x74 0x04 0x00 0x75 0x04 0x00 0x76 0x04 0x00 0x77 0x04 0x00 0x78 0x04 0x00 0x79 0x04 0x00 0x7a 0x04 0x00 0x7b 0x04>;
		interrupt-parent = <0x01>;
		compatible = "bitmain,top-intc";
		#interrupt-cells = <0x02>;
		status = "okay";
		interrupt-names = "msi0\0msi1\0msi2\0msi3\0msi4\0msi5\0msi6\0msi7\0msi8\0msi9\0msi10\0msi11\0msi12\0msi13\0msi14\0msi15";
		reg = <0x00 0x500100bc 0x00 0x04 0x00 0x50010198 0x00 0x04 0x00 0x5001019c 0x00 0x04>;
		phandle = <0x2a>;
		reg-bitwidth = <0x20>;
		for-msi;
		interrupt-controller;

		top_intc_test@0 {
			interrupts = <0x00 0x04 0x07 0x04>;
			interrupt-parent = <0x2a>;
			compatible = "bitmain,top-intc-test";
			interrupt-names = "msi0_test\0msi7_test";
		};
	};

	bce@58004000 {
		clock-names = "spacc";
		bus-width = <0x04>;
		resets = <0x14 0x30>;
		interrupts = <0x00 0x12 0x04>;
		clocks = <0x07 0x81>;
		resets-names = "spacc";
		compatible = "bitmain,crypto-engine,v2";
		reg = <0x00 0x12008000 0x00 0x1000>;
	};

	psci {
		method = "smc";
		compatible = "arm,psci-1.0\0arm,psci";
	};

	info {
		file-name = "bm1684x_sm7m_v1.0.dtb";
	};

	rx-queues-config {
		snps,rx-queues-to-use = <0x04>;
		phandle = <0x21>;

		queue3 {
		};

		queue1 {
		};

		queue2 {
		};

		queue0 {
		};
	};

	gpio@50027800 {
		#address-cells = <0x01>;
		clock-names = "base_clk\0intr_clk\0db_clk";
		clocks = <0x07 0x3d 0x07 0x48 0x07 0x61>;
		#size-cells = <0x00>;
		compatible = "snps,dw-apb-gpio";
		reg = <0x00 0x50027800 0x00 0x400>;

		gpio-controller@2 {
			gpio-controller;
			interrupts = <0x00 0x16 0x04>;
			interrupt-parent = <0x01>;
			compatible = "snps,dw-apb-gpio-port";
			#interrupt-cells = <0x02>;
			reg = <0x00>;
			bank-name = "port2a";
			snps,nr-gpios = <0x20>;
			#gpio-cells = <0x02>;
			interrupt-controller;
		};
	};

	gpio-keys {
	};

	bmperf {
		compatible = "bitmain,bmperf";
	};

	pcie@5fb80000 {
		#address-cells = <0x03>;
		bus-range = <0x00 0xff>;
		clock-names = "pcie_clk";
		reg-names = "top_apb\0apb\0dbi\0config";
		interrupts = <0x00 0x2c 0x04>;
		clocks = <0x07 0x55>;
		interrupt-map = <0x00 0x00 0x00 0x01 0x01 0x00 0x00 0x00 0x6f 0x04 0x00 0x00 0x00 0x02 0x01 0x00 0x00 0x00 0x70 0x04 0x00 0x00 0x00 0x03 0x01 0x00 0x00 0x00 0x71 0x04 0x00 0x00 0x00 0x04 0x01 0x00 0x00 0x00 0x72 0x04>;
		#size-cells = <0x02>;
		reset-gpio = <0x12 0x10 0x00>;
		device_type = "pci";
		interrupt-map-mask = <0x00 0x00 0x00 0x07>;
		num-lanes = <0x08>;
		compatible = "bitmain,bm168x-pcie\0snps,dw-pcie";
		ranges = <0x81000000 0x00 0x80100000 0x00 0x80100000 0x00 0xf00000 0x82000000 0x00 0x81000000 0x00 0x81000000 0x00 0x7f000000>;
		#interrupt-cells = <0x01>;
		status = "okay";
		interrupt-names = "msi";
		num-viewport = <0x03>;
		reg = <0x00 0x5fb80000 0x00 0x80000 0x00 0x5fa00000 0x00 0x100000 0x00 0x5fc00000 0x00 0x400000 0x00 0x80000000 0x00 0x100000>;

		pci@0,0 {
			#address-cells = <0x03>;
			#size-cells = <0x02>;
			device_type = "pci";
			compatible = "pci1e30,1684";
			ranges;
			reg = <0x00 0x00 0x00 0x00 0x00>;

			asm3142@1,0 {
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				compatible = "pci1b21,2142";
				reg = <0x00 0x00 0x00 0x00 0x00>;

				device@2 {
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					compatible = "usb174c,1153";
					reg = <0x02>;
				};

				hub@3 {
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					compatible = "usbbda:5411";
					reg = <0x03>;

					hub@1 {
						#address-cells = <0x01>;
						#size-cells = <0x00>;
						compatible = "usb1a40,201";
						reg = <0x01>;

						device@6 {
							compatible = "usb8bb,2902";
							reg = <0x06>;
						};

						device@7 {
							#address-cells = <0x02>;
							#size-cells = <0x00>;
							compatible = "usb1a86,55d2";
							reg = <0x07>;

							interface@2 {
								compatible = "usbif1a86,55d2.config1.2";
								reg = <0x00 0x02>;

								gps {
									compatible = "gps";
								};
							};

							interface@0 {
								compatible = "usbif1a86,55d2.config1.0";
								reg = <0x00 0x01>;

								gpioc3 {
									gpio-controller;
									gpio-line-names = "DI0\0DI1\0DI2\0DO0\0DO1\0DO2\0\0\0\0LTE_EN\0WIFI_EN";
									cmd-timeout = <0x64>;
									current-speed = <0xf4240>;
									compatible = "aios,gpio";
									status = "okay";
									#gpio-cells = <0x02>;
									ngpios = <0x0b>;
									auto-baudrate;
								};
							};
						};

						device@5 {
							compatible = "usb4c4a,4155";
							reg = <0x05>;
						};
					};
				};

				hub@1 {
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					compatible = "usbbda:411";
					reg = <0x01>;
				};
			};
		};
	};

	i2c@5001C000 {
		#address-cells = <0x01>;
		clock-names = "pclk";
		resets = <0x14 0x1b>;
		interrupts = <0x00 0x1a 0x04>;
		clocks = <0x07 0x3f>;
		#size-cells = <0x00>;
		clock-frequency = <0x186a0>;
		compatible = "snps,designware-i2c";
		reg = <0x00 0x5001c000 0x00 0x1000>;
		reset-names = "i2c1";

		bm16xxwdt@69 {
			flavor = "strict";
			compatible = "bitmain,bm16xx-wdt";
			reg = <0x69>;
		};

		bm16xxmcu@17 {
			nvmem-cells = <0x15 0x16 0x17>;
			gpio-controller;
			gpio-line-names = "USB_EN\0GPS_EN";
			compatible = "bitmain,bm16xx-mcu";
			nvmem-cell-names = "sn\0mac0\0mac1";
			reg = <0x17>;
			#gpio-cells = <0x02>;

			gps_en {
				gpio-hog;
				output-high;
				status = "okay";
				gpios = <0x01 0x00>;
			};

			usb_en {
				gpio-hog;
				output-high;
				status = "okay";
				gpios = <0x00 0x00>;
			};
		};

		tmp451@6b {
			gain = [31 00];
			offset = "-5000";
			#thermal-sensor-cells = <0x01>;
			compatible = "ti,tmp451";
			reg = <0x6b>;
			phandle = <0x2b>;
		};

		bm16xxeeprom@6a {
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			compatible = "bitmain,bm16xx-eeprom";
			size = <0xc00>;
			reg = <0x6a>;

			mac0@0020 {
				reg = <0x20 0x06>;
				phandle = <0x16>;
			};

			sn@0000 {
				reg = <0x00 0x11>;
				phandle = <0x15>;
			};

			mac1@0040 {
				reg = <0x40 0x06>;
				phandle = <0x17>;
			};
		};
	};

	ethernet@5010C000 {
		snps,multicast-filter-bins = <0x00>;
		phy-mode = "rgmii-id";
		snps,txpbl = <0x20>;
		snps,mtl-rx-config = <0x21>;
		snps,aal;
