	bitmain-ion {
		compatible = "bitmain,bitmain-ion";

		heap_carveout@0 {
			memory-region = <0x28>;
			compatible = "bitmain,carveout_npu";
		};

		heap_carveout@1 {
			memory-region = <0x29>;
			compatible = "bitmain,carveout_vpp";
		};

		heap_carveout@2 {
			memory-region = <0x35>;
			compatible = "bitmain,carveout_vpu";
		};
	};

	gpio_intr@0 {
		interrupts = <0x00 0x04>;
		interrupt-parent = <0x12>;
		compatible = "sophgo,gpio-intr";
		status = "disabled";
		interrupt-names = "test";
	};

	pwm-fan {
		pwm-names = "pwm0\0pwm1";
		cooling-levels = <0x99 0x80 0x4d 0x1a 0x01>;
		compatible = "pwm-fan";
		phandle = <0x30>;
		pwms = <0x36 0x00 0x9c40 0x36 0x01 0x9c40>;
		pwm_inuse = "pwm0";
		#cooling-cells = <0x02>;
	};

	bm-emmc@50100000 {
		clock-names = "clk_gate_emmc\0clk_gate_axi_emmc\0clk_gate_100k_emmc";
		reg-names = "core_mem";
		bus-width = <0x04>;
		non-removable;
		no-sdio;
		resets = <0x14 0x14>;
		interrupts = <0x00 0x10 0x04>;
		clocks = <0x07 0x2b 0x07 0x4f 0x07 0x5f>;
		no-sd;
		compatible = "bitmain,bm-emmc";
		reg = <0x00 0x50100000 0x00 0x1000>;
		reset-names = "emmc";
	};

	tach@50029020 {
		pinctrl-names = "default";
		pinctrl-0 = <0x1e>;
		compatible = "bitmain,bm-tach";
		reg = <0x00 0x50029020 0x00 0x08>;
	};

	aliases {
		ethernet0 = "/ethernet@50108000";
		ethernet1 = "/ethernet@5010C000";
		serial0 = "/serial@50118000";
	};

	spinlock {
		subctrl-syscon = <0x02 0x50 0x04>;
		spinlock_numbers = <0x08>;
		compatible = "bitmain,hwspinlock";
		phandle = <0x34>;
		#hwlock-cells = <0x01>;
	};

	gpio@50027400 {
		#address-cells = <0x01>;
		clock-names = "base_clk\0intr_clk\0db_clk";
		clocks = <0x07 0x3d 0x07 0x48 0x07 0x61>;
		#size-cells = <0x00>;
		compatible = "snps,dw-apb-gpio";
		reg = <0x00 0x50027400 0x00 0x400>;

		gpio-controller@1 {
			gpio-controller;
			interrupts = <0x00 0x15 0x04>;
			interrupt-parent = <0x01>;
			compatible = "snps,dw-apb-gpio-port";
			#interrupt-cells = <0x02>;
			reg = <0x00>;
			phandle = <0x24>;
			bank-name = "port1a";
			snps,nr-gpios = <0x20>;
			#gpio-cells = <0x02>;
			interrupt-controller;
		};
	};

	bmtpu {
		clock-names = "tpu\0gdma\0axi8_cdma\0axi8_mmu\0axi8_pcie\0fixed_tpu_clk\0apb_intc\0arm9\0axi_sram\0clk_gate_hau_ngs\0clk_gate_tpu_for_tpu_only";
		resets = <0x14 0x01 0x14 0x0f 0x14 0x11 0x14 0x2b 0x14 0x2c>;
		memory-region = <0x25 0x26 0x27 0x28 0x29>;
		interrupts = <0x00 0x2e 0x04 0x00 0x30 0x04>;
		clocks = <0x07 0x71 0x07 0x84 0x07 0x56 0x07 0x54 0x07 0x55 0x07 0x35 0x07 0x39 0x07 0x86 0x07 0x85 0x07 0x87 0x07 0x89>;
		sophgon_arm9_fw_mode = <0x01>;
		compatible = "bitmain,tpu-1684";
		reg = <0x00 0x900c000 0x00 0x80000 0x00 0x50000000 0x00 0x300000 0x00 0x58000000 0x00 0x10000>;
		reset-names = "arm9\0gdma\0tpu\0cdma\0smmu";
	};

	bm-sd@50101000 {
		clock-names = "clk_gate_sd\0clk_gate_axi_sd\0clk_gate_100k_sd";
		reg-names = "core_mem";
		no-mmc;
		pwr-gpio = <0x24 0x0a 0x00>;
		bus-width = <0x04>;
		no-sdio;
		resets = <0x14 0x15>;
		interrupts = <0x00 0x0e 0x04>;
		clocks = <0x07 0x2c 0x07 0x50 0x07 0x60>;
		compatible = "bitmain,bm-sd";
		reg = <0x00 0x50101000 0x00 0x1000>;
		reset-names = "sdio";
	};

	reset-controller {
		#reset-cells = <0x01>;
		subctrl-syscon = <0x02>;
		nr_resets = <0x51>;
		compatible = "bitmain,reset";
		phandle = <0x14>;
		top_rst_offset = <0xc00>;
	};

	chosen {
		u-boot,version = "2022.10 59b1d659-dirty";
		linux,initrd-end = <0x03 0x3f7f7200>;
		bootargs = "console=ttyS0,115200 earlycon user_debug=31";
		u-boot,bootconf = "config-pcb139";
		linux,initrd-start = <0x03 0x3f1ad000>;
		stdout-path = "serial0";
	};

	pwm@50029000 {
		clocks = <0x07 0x41>;
		no-polarity;
		#pwm-cells = <0x02>;
		compatible = "bitmain,bm-pwm";
		pwm-num = <0x02>;
		reg = <0x00 0x50029000 0x00 0x20>;
		phandle = <0x36>;
	};

	efuse@50028000 {
		#address-cells = <0x01>;
		nvmem-cells = <0x19 0x1a 0x1b 0x1c 0x1d>;
		secure-lock-bits = <0x01 0x03>;
		clock-names = "base_clk\0apb_clk";
		clocks = <0x07 0x34 0x07 0x3b>;
		secure-regions = <0x02 0x10>;
		sram_read_enable = <0x01>;
		#size-cells = <0x01>;
		num_address_bits = <0x07>;
		compatible = "bitmain,bm-efuse";
		nvmem-cell-names = "secure-key-enable\0secure-key\0secure-key-backup\0uid\0uid-backup";
		reg = <0x00 0x50028000 0x00 0x1000>;

		secure-key@8 {
			reg = <0x08 0x20>;
			phandle = <0x1a>;
		};

		secure-key-enable@4 {
			bits = <0x00 0x02>;
			reg = <0x04 0x01>;
			phandle = <0x19>;
		};

		uid@d8 {
			reg = <0xd8 0x10>;
			phandle = <0x1c>;
		};

		uid-backup@e8 {
			reg = <0xe8 0x10>;
			phandle = <0x1d>;
		};

		secure-key-backup@28 {
			reg = <0x28 0x20>;
			phandle = <0x1b>;
		};
	};

	serial@5011A000 {
		reg-io-width = <0x04>;
		clock-names = "baudclk\0apb_pclk";
		interrupts = <0x00 0x04 0x04>;
		clocks = <0x07 0x33 0x07 0x53>;
		clock-frequency = <0x1dcd6500>;
		compatible = "snps,dw-apb-uart";
		reg = <0x00 0x5011a000 0x00 0x2000>;
		reg-shift = <0x02>;
	};

	i2c@5001E000 {
		pinctrl-names = "default";
		#address-cells = <0x01>;
		pinctrl-0 = <0x18>;
		clock-names = "pclk";
		resets = <0x14 0x1c>;
		clocks = <0x07 0x3f>;
		#size-cells = <0x00>;
		clock-frequency = <0x186a0>;
