diff --git a/envsetup_soc.sh b/envsetup_soc.sh
index e2bd8ad..83c906d 100755
--- a/envsetup_soc.sh
+++ b/envsetup_soc.sh
@@ -687,7 +687,8 @@ rm -rf /var/lib/apt/lists/*
 export DEBIAN_FRONTEND=noninteractive
 apt-get update
 apt-get install -y --no-install-recommends \
-  dnsmasq curl ca-certificates 
+  network-manager dnsmasq curl ca-certificates wpasupplicant iw isc-dhcp-client \
+  avahi-daemon avahi-utils \
 
 # install uv to system path in rootfs 
 curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR=/usr/local/bin sh
@@ -1366,7 +1367,8 @@ function build_package()
     sudo chown 1000:1000 -R rootfs_rw/overlay/home/linaro
 
     sudo mkdir -p rootfs_rw/overlay/opt
-    sudo mv "${EDGE_ROOTFS_DIR}"/opt/sophon rootfs_rw/overlay/opt/
+    sudo rm -rf rootfs_rw/overlay/opt/sophon
+    sudo cp -a "${EDGE_ROOTFS_DIR}"/opt/sophon rootfs_rw/overlay/opt/
 
     sudo mkdir -p rootfs_rw/overlay/opt/tunstar
     sudo cp -a "${TOP_DIR}/ubuntu/bootloader-arm64/third-part/star-llm" \
