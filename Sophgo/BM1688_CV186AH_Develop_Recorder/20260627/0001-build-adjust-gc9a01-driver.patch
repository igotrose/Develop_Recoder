+++ b/boards/sophon/edge_wevb_emmc/linux/edge_wevb_emmc_defconfig
@@ -180,7 +180,6 @@ CONFIG_ION=y
 CONFIG_ION_SYSTEM_HEAP=y
 CONFIG_ION_CARVEOUT_HEAP=y
 CONFIG_ION_CMA_HEAP=y
-CONFIG_PWM=n
 CONFIG_ANDROID=y
 # CONFIG_GATOR is not set
