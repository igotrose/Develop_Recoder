@@ -378,6 +377,12 @@ CONFIG_USB_DWC3_GADGET=y
 CONFIG_USB_DWC3_DUAL_ROLE=y
 CONFIG_USB_DWC3_OF_SIMPLE=y
 
+CONFIG_TYPEC=y
+CONFIG_TYPEC_TCPM=y
+CONFIG_TYPEC_TCPCI=y
+CONFIG_TYPEC_FUSB302=y
+CONFIG_TYPEC_HUSB311=y
+
 CONFIG_USB_XHCI_HCD=y
 CONFIG_USB_XHCI_PLATFORM=y
 
@@ -733,6 +738,7 @@ CONFIG_IIO=y
 CONFIG_CVITEK_ADC=m
 
 CONFIG_PWM=y
+CONFIG_BACKLIGHT_PWM=y
 CONFIG_CVITEK_PWM=m
 
 CONFIG_INPUT_KEYBOARD=y
@@ -758,7 +764,7 @@ CONFIG_IWLMVM=m
 CONFIG_AIC_WLAN_SUPPORT=y
 CONFIG_AIC8800_WLAN_SUPPORT=m
 CONFIG_AIC_LOADFW_SUPPORT=m
-CONFIG_RTL8822CU=m
+CONFIG_RTL8822CU=y
 CONFIG_USB_USBNET=y
 CONFIG_USB_NET_RNDIS_WLAN=y
 CONFIG_USB_NET_DRIVERS=y
@@ -854,3 +860,8 @@ CONFIG_CGROUP_BPF=y
 CONFIG_COMPAT=y
 CONFIG_COMPAT_32BIT_TIME=y
 CONFIG_COMPAT_BINFMT_ELF=y
+
+CONFIG_BACKLIGHT_CLASS_DEVICE=y
+CONFIG_DRM_MIPI_DBI=y
+CONFIG_TINYDRM_GC9A01=y
+CONFIG_DRM_FBDEV_EMULATION=y
diff --git a/boards/sophon/edge_wevb_emmc/multi.its b/boards/sophon/edge_wevb_emmc/multi.its
index f643c36..5d758a1 100755
